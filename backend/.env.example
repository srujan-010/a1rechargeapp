# Google Play Console Reviewer / Test Account Configuration (Server-Side Bypass)
# GOOGLE_PLAY_REVIEWER_PHONE: 10-digit mobile number dedicated solely to Google Play Console review.
# Must NOT match any existing real customer/admin/retailer phone number.
# GOOGLE_PLAY_REVIEWER_OTP: Secret 6-digit OTP chosen by deployment owner (NO DEFAULT).
# GOOGLE_PLAY_REVIEWER_PIN: Secret 6-digit non-repeating, non-sequential PIN for app lock & wallet (NO DEFAULT).
GOOGLE_PLAY_REVIEWER_PHONE=
GOOGLE_PLAY_REVIEWER_OTP=
GOOGLE_PLAY_REVIEWER_PIN=
